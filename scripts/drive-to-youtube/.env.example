# Google OAuth2 credentials (from Google Cloud Console)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=

# Google Drive folder ID to watch for new videos
# (find this in the Drive folder URL: https://drive.google.com/drive/folders/<FOLDER_ID>)
DRIVE_FOLDER_ID=

# Email address to send upload notifications to
NOTIFICATION_EMAIL=info@lvturf.com
